# MissionControl AI — copy to .env.local. Names and safe placeholders only.
# LOCAL DEMO needs nothing: every provider defaults to a labelled demo implementation.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true                       # production: false (also disables demo seed + local sign-in)
LIVE_EXTERNAL_ACTIONS_ENABLED=false  # true only after n8n is configured and tested

# --- Database / auth -------------------------------------------------------
DATABASE_URL=                        # empty => embedded PGlite in .data/pglite (demo only)
DIRECT_DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only
SESSION_SECRET=                      # production: >= 32 random chars
INTEGRATION_ENCRYPTION_KEY=          # openssl rand -base64 32 (required in production)

# --- Models ------------------------------------------------------------------
LLM_PROVIDER=demo                    # demo | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Sponsor integrations (all optional) --------------------------------------
ORCHESTRATOR_PROVIDER=demo           # demo | rocketride
ROCKETRIDE_API_KEY=
ROCKETRIDE_BASE_URL=                 # https://api.rocketride.ai or ws://localhost:5565
ROCKETRIDE_WORKSPACE_ID=
ROCKETRIDE_PIPELINE_ID=
ROCKETRIDE_PIPELINE_FILE=            # path to the .pipe JSON used for task runs
AVATAR_PROVIDER=demo                 # demo | masky
MASKY_API_KEY=
MASKY_BASE_URL=https://masky.ai/api
MASKY_WORKSPACE_ID=
MASKY_AVATAR_IDS=                    # alex=<avatarId>,maya=<avatarId>,...
N8N_BASE_URL=
N8N_API_KEY=
N8N_LEADS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=                  # >= 16 chars; also verifies inbound callbacks

WEB_RESEARCH_PROVIDER=demo           # demo | http (fetches only domains listed on a mission)
WEB_RESEARCH_API_KEY=
SANDBOX_PROVIDER=demo                # demo | tenki (not implemented) | disabled
TENKI_API_KEY=

# --- Runtime -----------------------------------------------------------------
WORKER_CONCURRENCY=2
EMBEDDED_WORKER=                     # default: true without DATABASE_URL, false with it
DEMO_STEP_DELAY_MS=900               # pacing so the mission room is watchable
MISSION_TIMEOUT_SECONDS=900
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
CRON_SECRET=

# CI only; never in the browser or app runtime.
SNYK_TOKEN=
SNYK_ORG_ID=

# Not implemented in this MVP (no billing, no email sending).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
